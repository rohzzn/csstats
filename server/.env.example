HOST=0.0.0.0
PORT=3000

STEAM_BOT_USERNAME=
STEAM_BOT_PASSWORD=

# Optional. Recommended if the Steam account has a mobile authenticator.
STEAM_BOT_SHARED_SECRET=

# Optional. The server will save a refresh token after a successful login.
STEAM_BOT_REFRESH_TOKEN=

# Optional. Use only when Steam emails a one-time code during first setup.
STEAM_BOT_GUARD_CODE=
