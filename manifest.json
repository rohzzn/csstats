{
  "manifest_version": 3,
  "name": "CS Stats",
  "short_name": "CS Stats",
  "version": "1.2.2",
  "minimum_chrome_version": "111",
  "description": "Is this CS2 player any good, or cheating? See Premier, FACEIT ELO, a cheat verdict and recent matches on every Steam profile.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://steamcommunity.com/*",
    "https://api-public.cs-prod.leetify.com/*",
    "https://open.faceit.com/*",
    "https://www.faceit.com/*",
    "https://api.steampowered.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://a1.allstar.gg/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "popup.html",
  "content_scripts": [
    {
      "matches": [
        "https://steamcommunity.com/id/*",
        "https://steamcommunity.com/profiles/*"
      ],
      "js": [
        "settings.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "faceit/*.svg",
        "csranks/*.svg",
        "wingman/*.svg",
        "commendations/*.svg",
        "levels/*.png",
        "premier/*.png",
        "collectibles-images/*.png",
        "maps-icons/*.svg",
        "maps-icons/community/*.svg"
      ],
      "matches": [
        "https://steamcommunity.com/*"
      ]
    },
    {
      "resources": [
        "icon48.png"
      ],
      "matches": [
        "https://csstats.rohan.my/*"
      ]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CS Stats",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
