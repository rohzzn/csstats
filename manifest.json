{
  "manifest_version": 3,
  "name": "CS2 Recon",
  "short_name": "CS2 Recon",
  "version": "1.0.0",
  "description": "CS2 stats on every Steam profile. FACEIT rank, CS Rating, competitive ranks, Leetify ratings, account age and friend code.",
  "permissions": [],
  "host_permissions": [
    "https://steamcommunity.com/*",
    "https://api-public.cs-prod.leetify.com/*",
    "https://open.faceit.com/*",
    "https://csstats.gg/*",
    "https://api.steampowered.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://steamcommunity.com/id/*",
        "https://steamcommunity.com/profiles/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "faceit/*.svg",
        "csranks/*.svg",
        "wingman/*.svg"
      ],
      "matches": [
        "https://steamcommunity.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "CS2 Recon",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
